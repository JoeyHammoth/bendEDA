# SPDX-License-Identifier: Apache-2.0
# OSS CAD Suite (Yosys, SymbiYosys, MCY, Verilator, Icarus, nextpnr).
#
# Pinned by release tag and archive digest. The GitHub release metadata now
# publishes a sha256 per asset, and both digests below match it exactly:
#   linux-x64   6e200a57...  (754,324,403 bytes)
#   linux-arm64 d58ee2fa...  (691,664,066 bytes)
# The build re-checks the downloaded archive, so a tampered or swapped asset
# fails before anything is extracted.
#
# Verified by `.github/workflows/oss-cad-image.yml`: the image builds, the tools
# answer with their versions, and a real SymbiYosys BMC run passes.
#
# The suite is ~2.5 GB unpacked; the digest check is what makes a cached layer
# trustworthy.
FROM debian:bookworm-slim

ARG OSS_CAD_TAG=2026-11-20
ARG OSS_CAD_SHA256_LINUX_X64=6e200a57cb7cc47a8a1a4772e3feda3777917edcb3fa5e8ee5743d962d265a7e
ARG OSS_CAD_SHA256_LINUX_ARM64=d58ee2faa0b0b1e43aa8783f66df9fbed5f23fe9d179a638f3d26d75301a6c93

ENV DEBIAN_FRONTEND=noninteractive \
    OSS_CAD_SUITE=/opt/oss-cad-suite \
    PATH=/opt/oss-cad-suite/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl tar xz-utils python3 \
      libstdc++6 zlib1g libreadline8 \
      g++ make \
 && rm -rf /var/lib/apt/lists/*
# g++ and make are for `verilator --binary`: it compiles the testbench harness
# before it simulates anything. Without them Verilator exits before running RTL.

RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) sum="$OSS_CAD_SHA256_LINUX_X64"; asset_arch=x64 ;; \
      arm64) sum="$OSS_CAD_SHA256_LINUX_ARM64"; asset_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    name="oss-cad-suite-linux-${asset_arch}-$(echo "$OSS_CAD_TAG" | tr -d '-').tgz"; \
    curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/oss.tgz \
      "https://github.com/YosysHQ/oss-cad-suite-build/releases/download/${OSS_CAD_TAG}/${name}"; \
    echo "${sum}  /tmp/oss.tgz" | sha256sum -c - ; \
    tar -xzf /tmp/oss.tgz -C /opt --no-same-owner; \
    rm /tmp/oss.tgz; \
    test -x "${OSS_CAD_SUITE}/bin/yosys"

# Fail the build, not the run, if a tool the gates need is missing. `sby --help`
# exits non-zero after printing usage, so the check is the pipeline, not sby.
RUN yosys -V \
 && verilator --version \
 && g++ --version | head -1 \
 && make --version | head -1 \
 && iverilog -V | head -1 \
 && sby --help | head -3 \
 && yosys-smtbmc --help >/dev/null

# Non-root, because the sandbox is the boundary and root is not free.
RUN useradd --create-home --uid 10003 eda
USER eda
WORKDIR /work
CMD ["/bin/bash"]
